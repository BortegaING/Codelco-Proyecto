<Window x:Class="TerminalVentanas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal Rotulado Ventanas" Width="1040" Height="807"
        Background="Black" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Viewbox Stretch="Uniform">
        <!-- La pantalla de la VT1200: 1024 x 768, escalada a lo que mida el monitor -->
        <Grid x:Name="Pantalla" Width="1024" Height="768" ClipToBounds="True">
            <Grid x:Name="Raiz" />
            <Grid x:Name="Capa" Visibility="Collapsed" />
            <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,118"
                    MaxWidth="820" CornerRadius="3" BorderThickness="1" Padding="18,14" IsHitTestVisible="False" />
            <Grid x:Name="PanelPrueba" Visibility="Collapsed" />
        </Grid>
    </Viewbox>
</Window>
