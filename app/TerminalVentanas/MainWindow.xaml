<Window x:Class="TerminalVentanas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Terminal Rotulado Ventanas" Width="1040" Height="807"
        Background="Black" WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="Black" />
        <Border x:Name="Aviso" Visibility="Collapsed" Background="#0E181E" Padding="48">
            <StackPanel VerticalAlignment="Center" MaxWidth="760">
                <TextBlock Text="Terminal Rotulado Ventanas" Foreground="#F0B37E" FontSize="30" FontWeight="Bold" Margin="0,0,0,16" />
                <TextBlock x:Name="AvisoTexto" Foreground="#D6E5EB" FontSize="20" TextWrapping="Wrap" LineHeight="30" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
