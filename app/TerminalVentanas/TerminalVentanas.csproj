<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TerminalVentanas</AssemblyName>
    <RootNamespace>TerminalVentanas</RootNamespace>
    <Version>3.0.0</Version>
    <Product>Terminal Rotulado Ventanas</Product>
    <Company>Ingmétrica</Company>
    <Description>Terminal de rotulado y pesaje de la Báscula N9 (Refinería Ventanas) para la VT1200. App nativa WPF.</Description>
    <!-- Siempre self-contained: la VT1200 no tiene .NET instalado -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Código QR de la etiqueta en pantalla y Excel del registro -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fuentes de la pantalla (licencia OFL), dentro del programa -->
    <Resource Include="Fuentes\*.ttf" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="LICENCIAS.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
